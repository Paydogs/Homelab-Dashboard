<div class="mblock stat">
  <span class="eyebrow">Services</span>
  <span class="stat-num">{{.OK}}/{{.Total}}</span>
</div>
<div class="mblock stat">
  <span class="eyebrow">Hosts</span>
  <span class="stat-num">{{.Hosts}}</span>
</div>
<div class="mblock stat">
  <span class="eyebrow">Alerts</span>
  <span class="stat-num alerts {{if gt .Alerts 0}}has-alerts{{end}}">{{.Alerts}}</span>
</div>