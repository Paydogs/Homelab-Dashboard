<div class="row" data-tags="{{join .Tags " "}}" data-text="{{lower .Name}} {{lower (join .Tags " ")}}{{if .URL}} {{lower .URL}}{{end}}{{if .Run}} {{lower .Run}}{{end}}">
  <div class="row-icon">
    {{if .Icon}}<img class="card-icon" src="{{.Icon}}" alt="" loading="lazy">{{end}}
  </div>
  <div class="row-main">
    <div class="row-title">
      {{if .URL}}
        <a href="{{.URL}}" target="_blank" rel="noopener">{{.Name}}</a>
      {{else}}
        <span>{{.Name}}</span>
      {{end}}
    </div>
    {{if .URL}}<div class="row-url">{{.URL}}</div>{{end}}
    {{if .Tags}}
    <div class="row-tags">
      {{range .Tags}}<span class="tag-chip">{{.}}</span>{{end}}
    </div>
    {{end}}
  </div>
  <div class="row-status">
    {{if .Health}}
      {{with .Health}}{{template "components/health-status.tmpl" .}}{{end}}
    {{else if .Run}}
      <div class="run" x-data="{open: false}" @keydown.escape="open = false">
        <button class="btn-run" type="button" @click="open = true">run…</button>
        <div class="confirm" x-show="open" x-cloak>
          <span class="confirm-text">Run “{{.Name}}”?</span>
          <button class="btn-confirm" type="button" @click="open = false; dashboardRun('{{.Key}}')">Run</button>
          <button class="btn-cancel" type="button" @click="open = false">Cancel</button>
        </div>
      </div>
    {{end}}
  </div>
</div>