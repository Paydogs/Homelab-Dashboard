<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="icon" href="/static/icons/globe.svg">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">
<meta name="description" content="Homelab dashboard — services, health and quick links">
<meta name="theme-color" content="#2e222f">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="stylesheet" href="/static/css/main.css">
<style>{{.StylesCSS}}</style>
<script src="/static/vendor/htmx.min.js" defer></script>
<script src="/static/vendor/alpine.min.js" defer></script>
<script src="/static/js/ui.js" defer></script>
</head>
<body>

<header class="masthead">
  <div class="masthead-top">
    <div class="eyebrow masthead-title">{{.Title}}</div>
    <div class="masthead-tools">
      <label class="style-picker">
        <select id="style-select" aria-label="style" data-default="{{.DefaultStyle}}">
          {{range .Styles}}<option value="{{.ID}}"{{if eq .ID $.DefaultStyle}} selected{{end}}>{{.Name}}</option>{{end}}
        </select>
      </label>
      {{if .CanOpenFolder}}
      <button id="open-data-btn" class="edit-btn" type="button" title="Data folder — show, open, or change" aria-label="Data folder">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/>
        </svg>
      </button>
      {{end}}
      {{if .CanEdit}}
      <button id="edit-style-btn" class="edit-btn" type="button" title="Edit the current style (base + overrides)" aria-label="Edit style">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 4a7.7 7.7 0 1 0 .6 15.4L21 19a1 1 0 0 0 .8-1.4L13.6 4.7A3 3 0 0 0 11 4Z"/>
          <circle cx="8.5" cy="11.5" r="1" fill="currentColor" stroke="none"/>
          <circle cx="11" cy="14" r="1" fill="currentColor" stroke="none"/>
        </svg>
      </button>
      <button id="edit-config-btn" class="edit-btn" type="button" title="Edit config.yml directly" aria-label="Edit config">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17v3Z"/>
          <path d="M13.5 6.5l3 3"/>
        </svg>
      </button>
      {{end}}
    </div>
  </div>
  <div class="masthead-blocks">
    <div class="mblock clock-block">
      <div class="clock">
        <span id="clock-time">--:--</span><span class="clock-seconds" id="clock-seconds">00</span>
      </div>
      <div class="clock-date" id="clock-date"></div>
    </div>
    <div class="masthead-stats" hx-get="/summary" hx-trigger="every 15s" hx-swap="innerHTML">
      {{template "summary.tmpl" .Summary}}
    </div>
  </div>
</header>

{{if .ConfigError}}
<div class="config-error" role="alert">
  <span class="eyebrow">Config error</span>
  <span class="config-error-text">{{.ConfigError}}</span>
</div>
{{end}}

<section class="filter-row" aria-label="filter">
  <span class="eyebrow">Filter</span>
  <input id="search" class="search" type="search"
         placeholder="search name, tag or url/ip… (matches every group)" autocomplete="off" autofocus>
  <div class="tag-filter" id="tag-filter">
    <button class="tag active" data-tag="">all</button>
    {{range .AllTags}}<button class="tag" data-tag="{{.}}">{{.}}</button>{{end}}
  </div>
</section>

<div class="frame{{if .CardCols}} has-cards{{end}}">
  <aside class="sidebar">
    {{if .Sidebar}}
    {{template "groups-list.tmpl" .Sidebar}}
    {{else}}
    <p class="empty">No groups configured — edit <code>config.yml</code> and refresh.</p>
    {{end}}
  </aside>

  {{range $i, $col := .CardCols}}
  <nav class="group-cards{{if ne $i 0}} hidden{{end}}" data-root="{{$col.Root}}" aria-label="sub-groups of {{$col.Root}}">
    {{range $col.Cards}}
    <button class="group-item" data-path="{{.Path}}" type="button">
      <span class="group-item-name">{{.Name}} <span class="group-item-total">· {{.Total}}</span></span>
      <span class="group-item-counts">
        {{if .OK}}<span class="count ok">{{.OK}} ok</span>{{end}}
        {{if .Error}}<span class="count err">{{.Error}} err</span>{{end}}
      </span>
    </button>
    {{end}}
  </nav>
  {{end}}

  <main class="panel">
    {{range .Panels}}
    <section class="group-panel {{if not .Selected}}hidden{{end}}{{if .Selected}} selected{{end}}" data-path="{{.Path}}">
      <header class="panel-head">
        <div class="panel-id">
          <h2>{{.Name}}</h2>
          {{with .Subtitle}}<div class="panel-sub">{{.}}</div>{{end}}
        </div>
        <div class="panel-state">
          <div class="panel-fraction">{{.Fraction}}</div>
        </div>
      </header>
      <div class="rows">
        {{range .Items}}{{template "components/card.tmpl" .}}{{end}}
        {{if not .Items}}<div class="row-empty">no services yet</div>{{end}}
      </div>
    </section>
    {{end}}
  </main>
</div>

<div id="toast-stack" class="toast-stack"></div>

<div id="edit-overlay" class="overlay" hidden>
  <div class="overlay-panel">
    <div class="overlay-head">
      <span class="eyebrow" id="edit-title">Edit config.yml</span>
      <button id="edit-close" class="edit-btn" type="button" title="Close (Esc)" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="overlay-body" id="edit-single">
      <textarea id="edit-textarea" spellcheck="false" wrap="off"></textarea>
    </div>
    <div class="overlay-body split hidden" id="edit-split">
      <div class="pane">
        <div class="pane-label"><span class="eyebrow" id="pane-base-label">base</span><span class="pane-note">read-only</span></div>
        <textarea id="edit-base" spellcheck="false" wrap="off" readonly></textarea>
      </div>
      <div class="pane">
        <div class="pane-label"><span class="eyebrow" id="pane-over-label">overrides</span><span class="pane-note">edit only what changes</span></div>
        <textarea id="edit-overwrite" spellcheck="false" wrap="off"></textarea>
      </div>
    </div>
    <div class="overlay-foot">
      <span id="edit-error" class="edit-error" role="alert"></span>
      <button id="edit-save" class="edit-btn" type="button" title="Save" aria-label="Save">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/>
          <path d="M17 21v-8H7v8M7 3v5h8"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<div id="data-overlay" class="overlay" hidden>
  <div class="overlay-panel data-panel">
    <div class="overlay-head">
      <span class="eyebrow">Data folder</span>
      <button id="data-close" class="edit-btn" type="button" title="Close (Esc)" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="overlay-body data-body">
      <input id="data-path" type="text" spellcheck="false" placeholder="folder holding config.yml + resources/">
      <p class="pane-note">The folder is created when missing and seeded with the sample config + starter
      styles when empty. The choice applies right away and is remembered on the next launch.</p>
    </div>
    <div class="overlay-foot">
      <span id="data-error" class="edit-error" role="alert"></span>
      <button id="data-open" class="btn-header" type="button">Open folder</button>
      <button id="data-set" class="btn-header" type="button">Use this folder</button>
    </div>
  </div>
</div>
</body>
</html>